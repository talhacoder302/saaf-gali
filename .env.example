# Copy this file to .env.local and fill in the values.
# Only MONGODB_URI and AUTH_SECRET are needed to run the app locally.
# R2, Resend and VAPID are optional: when their keys are missing those
# features are switched off instead of crashing the app.

# --- App ---
NEXT_PUBLIC_APP_URL=

# --- MongoDB Atlas ---
MONGODB_URI=
MONGODB_DB_NAME=

# --- Auth.js (generate AUTH_SECRET with: npx auth secret) ---
AUTH_SECRET=
AUTH_URL=
AUTH_TRUST_HOST=

# --- Cloudflare R2 (photo uploads) ---
# Without these, forms save without photos. The bucket needs a CORS rule that
# allows PUT with the Content-Type header from NEXT_PUBLIC_APP_URL.
# R2_PUBLIC_URL is optional (a public bucket or custom domain); when empty,
# photos are shown through pre-signed links that last an hour.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Resend (email) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Web push (generate with: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Seed script ---
SEED_ADMIN_MOBILE=
SEED_ADMIN_PASSWORD=
